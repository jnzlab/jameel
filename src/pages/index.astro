---
import { getCollection } from "astro:content";
import { GITHUB_ACCESS_TOKEN } from "astro:env/server";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CommitLog from "@/components/CommitLog.astro";
import Hero from "@/components/home/Hero.astro";
import SectionHead from "@/components/home/SectionHead.astro";
import WorkList from "@/components/home/WorkList.astro";
import OpenSource from "@/components/home/OpenSource.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getGitHubReposCurated } from "@/utils/github";
import { projects } from "@/data/projects";
import { contributions, milestones } from "@/data/career";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const latestPosts = sortedPosts.slice(0, 6);

const repoRefs = projects.flatMap(p => (p.repo ? [p.repo] : []));

let githubRepos: Awaited<ReturnType<typeof getGitHubReposCurated>> = [];
try {
  githubRepos = await getGitHubReposCurated(repoRefs, {
    ...(GITHUB_ACCESS_TOKEN ? { token: GITHUB_ACCESS_TOKEN } : {}),
  });
} catch (error) {
  // eslint-disable-next-line no-console
  console.warn("[github] Failed to fetch portfolio repos:", error);
  githubRepos = [];
}

const prCount = contributions.reduce((n, c) => n + c.prs.length, 0);
const mergedCount = contributions
  .filter(c => c.merged)
  .reduce((n, c) => n + c.prs.length, 0);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const sectionClass =
  "grid gap-8 border-t border-line py-16 sm:py-24 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-12 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16";
---

<Layout scrollSmooth>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout pb-8 sm:pb-12">
    <Hero />

    <section id="work" aria-labelledby="work-title" class={sectionClass}>
      <SectionHead
        id="work-title"
        title="Selected work"
        meta={plural(projects.length, "project")}
        link={{ href: "/about", label: "Full background" }}
      />
      <WorkList projects={projects} repos={githubRepos} />
    </section>

    <section id="writing" aria-labelledby="writing-title" class={sectionClass}>
      <SectionHead
        id="writing-title"
        title="Writing"
        meta={`Latest ${latestPosts.length} of ${sortedPosts.length} posts`}
        link={{ href: "/posts", label: "All writing" }}
      />
      <div class="min-w-0">
        <CommitLog posts={latestPosts} milestones={milestones} />
      </div>
    </section>

    <section id="open-source" aria-labelledby="oss-title" class={sectionClass}>
      <SectionHead
        id="oss-title"
        title="Open source"
        meta={`${plural(prCount, "pull request")} · ${mergedCount} merged`}
      />
      <OpenSource contributions={contributions} />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
