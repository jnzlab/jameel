---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CommitLog from "@/components/CommitLog.astro";
import postFilter from "@/utils/postFilter";
import { milestones } from "@/data/career";
import { SITE } from "@/config";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const posts = (await getCollection("blog", ({ data }) => !data.draft)).filter(
  postFilter
);

const years = [...posts.map(p => p.data.pubDatetime), ...milestones.map(m => m.date)].map(
  d => d.getFullYear()
);
const span = `${Math.min(...years)}–${Math.max(...years)}`;
---

<Layout title={`Archive | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="Archive"
    pageDesc="Every post and career milestone in one history, newest first."
    count={`${posts.length} posts · ${milestones.length} milestones · ${span}`}
  >
    <p class="type-meta mb-10 flex flex-wrap items-center gap-x-5 gap-y-2 text-ink-soft" aria-hidden="true">
      <span class="inline-flex items-center gap-2">
        <span class="inline-block size-2.5 rounded-full border-2 border-ink"></span>
        Post
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="inline-block size-2.5 rounded-full bg-marigold"></span>
        Featured
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="inline-block size-2 rotate-45 rounded-[2px] border-2 border-ink-soft"></span>
        Milestone
      </span>
    </p>

    <CommitLog posts={posts} milestones={milestones} groupByYear headingLevel="h2" />
  </Main>
  <Footer />
</Layout>
