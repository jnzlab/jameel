---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CommitLog from "@/components/CommitLog.astro";
import Pagination from "@/components/Pagination.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    // Publish order keeps the commit log continuous across pages
    const tagPosts = getPostsByTag(posts, tag).sort(
      (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
    );

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
---

<Layout title={`Tagged ${tagName} | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle={["Tagged", `${tagName}`]}
    titleTransition={tag}
    pageDesc={`Everything I've written about ${tagName}, newest first.`}
    count={`${page.total} ${page.total === 1 ? "post" : "posts"}`}
  >
    <CommitLog posts={page.data} groupByYear headingLevel="h2" />

    <Pagination {page} />

    <p class="mt-14 type-meta">
      <a
        href="/tags/"
        class="inline-flex items-center gap-1.5 text-cobalt underline decoration-cobalt/40 underline-offset-4 transition-colors hover:decoration-cobalt"
      >
        <IconArrowLeft class="size-3.5 rtl:rotate-180" aria-hidden="true" />
        All tags
      </a>
    </p>
  </Main>

  <Footer />
</Layout>
