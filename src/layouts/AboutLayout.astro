---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import IconDownload from "@/assets/icons/IconDownload.svg";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = MarkdownLayoutProps<{ title: string }>;

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>
      <a
        href={SITE.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-md border border-accent px-4 py-2 font-medium text-accent transition-colors hover:bg-accent hover:text-background"
      >
        <IconDownload class="inline-block size-4" />
        Download Resume
      </a>
    </div>
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">
      <slot />
    </section>
  </main>
  <Footer />
</Layout>
