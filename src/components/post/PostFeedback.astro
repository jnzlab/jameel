---
/**
 * End-of-post feedback: a Yes/No reaction that opens an optional comment form.
 * Submits to the `feedback` Astro Action. The reaction alone is enough to send.
 */
type Props = {
  /** Post id (collection entry id); the action checks it against the blog collection. */
  slug: string;
  class?: string;
};

const { slug, class: className } = Astro.props;
---

<section
  class:list={["feedback", className]}
  data-post-feedback
  data-slug={slug}
  data-state="idle"
  aria-labelledby="feedback-title"
  data-pagefind-ignore
>
  <!-- Step 1: reaction -->
  <div class="feedback__ask" data-feedback-ask>
    <div class="min-w-0">
      <h2 id="feedback-title" class="type-heading text-base text-ink">Was this post helpful?</h2>
      <p class="mt-1 text-sm text-ink-soft">Tell me what worked and what didn't. I read every note.</p>
    </div>
    <div class="flex shrink-0 gap-2" role="group" aria-labelledby="feedback-title">
      <button type="button" class="feedback__choice" data-helpful="yes" aria-pressed="false">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
          ><path
            d="M7 11v8a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1v-7a1 1 0 0 1 1 -1h3a4 4 0 0 0 4 -4v-1a2 2 0 0 1 4 0v5h3a2 2 0 0 1 2 2l-1 5a2 3 0 0 1 -2 2h-7a3 3 0 0 1 -3 -3"
          ></path></svg
        >
        Yes
      </button>
      <button type="button" class="feedback__choice" data-helpful="no" aria-pressed="false">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
          ><path
            d="M7 13v-8a1 1 0 0 0 -1 -1h-2a1 1 0 0 0 -1 1v7a1 1 0 0 0 1 1h3a4 4 0 0 1 4 4v1a2 2 0 0 0 4 0v-5h3a2 2 0 0 0 2 -2l-1 -5a2 3 0 0 0 -2 -2h-7a3 3 0 0 0 -3 3"
          ></path></svg
        >
        No
      </button>
    </div>
  </div>

  <!-- Step 2: optional comment (collapsed until a reaction is chosen) -->
  <div class="feedback__expand" data-feedback-expand inert>
    <div class="feedback__expand-inner">
      <form class="feedback__form" data-feedback-form novalidate>
        <input type="hidden" name="slug" value={slug} />
        <input type="hidden" name="helpful" value="" data-feedback-helpful />

        <div class="feedback__field">
          <label for="feedback-comment" class="feedback__label">
            <span data-feedback-question>What was most useful?</span>
            <span class="feedback__optional">Optional</span>
          </label>
          <textarea
            id="feedback-comment"
            name="comment"
            rows="4"
            maxlength="2000"
            class="feedback__input feedback__textarea"
            aria-describedby="feedback-comment-count feedback-comment-error"
            data-feedback-comment></textarea>
          <div class="flex items-start justify-between gap-4">
            <p id="feedback-comment-error" class="feedback__error" data-error-for="comment"></p>
            <p id="feedback-comment-count" class="type-meta ms-auto shrink-0 text-ink-soft" data-feedback-count>
              0 / 2,000
            </p>
          </div>
        </div>

        <div class="feedback__field">
          <label for="feedback-email" class="feedback__label">
            <span>Email, if you'd like a reply</span>
            <span class="feedback__optional">Optional</span>
          </label>
          <input
            id="feedback-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            spellcheck="false"
            maxlength="254"
            class="feedback__input"
            aria-describedby="feedback-email-hint feedback-email-error"
          />
          <p id="feedback-email-hint" class="text-sm text-ink-soft">Only I see it.</p>
          <p id="feedback-email-error" class="feedback__error" data-error-for="email"></p>
        </div>

        <div class="feedback__trap" aria-hidden="true">
          <label for="feedback-company">Company</label>
          <input id="feedback-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="feedback__turnstile" data-feedback-turnstile></div>

        <div class="feedback__form-status" data-feedback-status aria-live="polite"></div>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <button type="submit" class="btn btn-primary" data-feedback-submit>Send feedback</button>
          <button type="button" class="feedback__cancel" data-feedback-cancel>Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Confirmation (fresh submit, or returning reader) -->
  <div class="feedback__done" data-feedback-done tabindex="-1" role="status">
    <span class="feedback__dot" aria-hidden="true"></span>
    <p class="min-w-0 text-[0.95rem] text-ink">
      <span data-feedback-done-text></span>
      <span class="text-ink-soft" data-feedback-done-extra></span>
    </p>
    <button type="button" class="feedback__more" data-feedback-more hidden>Send more</button>
  </div>
</section>

<style>
  .feedback {
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: var(--surface);
    padding: 1.25rem;
  }
  @media (min-width: 640px) {
    .feedback {
      padding: 1.5rem 1.75rem;
    }
  }

  .feedback__ask {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .feedback__ask {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  .feedback__choice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      background-color 150ms,
      color 150ms,
      border-color 150ms,
      transform 150ms;
  }
  .feedback__choice:hover {
    border-color: var(--ink);
  }
  .feedback__choice:active {
    transform: translateY(1px);
  }
  .feedback__choice[aria-pressed="true"] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  /* Height + opacity reveal (grid 0fr -> 1fr) */
  .feedback__expand {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 260ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 200ms ease;
  }
  .feedback__expand-inner {
    min-height: 0;
    overflow: hidden;
    /* Room for focus rings, which overflow: hidden would clip */
    margin: 0 -6px -6px;
    padding: 0 6px 6px;
  }
  .feedback[data-state="open"] .feedback__expand {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .feedback__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .feedback__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .feedback__label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }
  .feedback__optional {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 0.7rem;
    font-weight: 450;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .feedback__input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--paper);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color 150ms;
  }
  .feedback__input:hover {
    border-color: color-mix(in oklab, var(--ink) 35%, var(--line));
  }
  .feedback__input:focus-visible {
    border-color: var(--cobalt);
    outline-offset: 1px;
  }
  .feedback__input[aria-invalid="true"] {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .feedback__textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .feedback__error {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }
  .feedback__error:empty {
    display: none;
  }
  .feedback__error::before,
  .feedback__form-status:not(:empty)::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-inline-end: 0.5rem;
    border-radius: 999px;
    background: var(--marigold);
    vertical-align: 0.1em;
  }

  .feedback__form-status {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }
  .feedback__turnstile:empty,
  .feedback__form-status:empty {
    display: none;
  }
  /* While Turnstile checks silently it has nothing to show: cancel the flex gap. */
  .feedback__turnstile[data-state="checking"] {
    margin-top: -1.25rem;
  }

  .feedback__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .feedback__cancel,
  .feedback__more {
    font-size: 0.9rem;
    color: var(--ink-soft);
    text-decoration-line: underline;
    text-decoration-color: color-mix(in oklab, var(--ink-soft) 40%, transparent);
    text-underline-offset: 0.2em;
    transition:
      color 150ms,
      text-decoration-color 150ms;
  }
  .feedback__cancel:hover,
  .feedback__more:hover {
    color: var(--cobalt);
    text-decoration-color: var(--cobalt);
  }

  .feedback__done {
    display: none;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 0.75rem;
    row-gap: 0.25rem;
  }
  .feedback__done:focus {
    outline: none;
  }
  .feedback__dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--marigold);
    transform: translateY(-0.05em);
  }
  .feedback__done p {
    flex: 1 1 16rem;
  }

  .feedback[data-state="done"],
  .feedback[data-state="sent"] {
    padding-block: 1rem;
  }
  .feedback[data-state="done"] .feedback__ask,
  .feedback[data-state="done"] .feedback__expand,
  .feedback[data-state="sent"] .feedback__ask,
  .feedback[data-state="sent"] .feedback__expand {
    display: none;
  }
  .feedback[data-state="done"] .feedback__done,
  .feedback[data-state="sent"] .feedback__done {
    display: flex;
    animation: feedback-in 260ms ease both;
  }

  @keyframes feedback-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feedback__expand {
      transition: none;
    }
    .feedback[data-state="done"] .feedback__done,
    .feedback[data-state="sent"] .feedback__done {
      animation: none;
    }
  }
</style>

<script>
  import { actions, isInputError } from "astro:actions";
  import { mountTurnstile, type TurnstileWidget } from "@/scripts/turnstile";

  type Helpful = "yes" | "no";
  type Saved = { helpful: Helpful; at: string };

  const QUESTIONS: Record<Helpful, string> = {
    yes: "What was most useful?",
    no: "What was missing or unclear?",
  };
  const FIELDS = ["comment", "email"] as const;
  const numberFormat = new Intl.NumberFormat("en-US");

  let cleanups: Array<() => void> = [];

  function storageKey(slug: string) {
    return `feedback:${slug}`;
  }

  function readSaved(slug: string): Saved | null {
    try {
      const raw = localStorage.getItem(storageKey(slug));
      return raw ? (JSON.parse(raw) as Saved) : null;
    } catch {
      return null;
    }
  }

  function writeSaved(slug: string, helpful: Helpful) {
    try {
      const value: Saved = { helpful, at: new Date().toISOString() };
      localStorage.setItem(storageKey(slug), JSON.stringify(value));
    } catch {
      // Storage blocked (private mode, disabled cookies): the thank-you still shows.
    }
  }

  function init() {
    const root = document.querySelector<HTMLElement>("[data-post-feedback]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const slug = root.dataset.slug ?? "";
    const q = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;

    const choices = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-helpful]"));
    const expand = q<HTMLElement>("[data-feedback-expand]");
    const form = q<HTMLFormElement>("[data-feedback-form]");
    const helpfulInput = q<HTMLInputElement>("[data-feedback-helpful]");
    const question = q<HTMLElement>("[data-feedback-question]");
    const comment = q<HTMLTextAreaElement>("[data-feedback-comment]");
    const count = q<HTMLElement>("[data-feedback-count]");
    const status = q<HTMLElement>("[data-feedback-status]");
    const submit = q<HTMLButtonElement>("[data-feedback-submit]");
    const cancel = q<HTMLButtonElement>("[data-feedback-cancel]");
    const turnstileEl = q<HTMLElement>("[data-feedback-turnstile]");
    const done = q<HTMLElement>("[data-feedback-done]");
    const doneText = q<HTMLElement>("[data-feedback-done-text]");
    const doneExtra = q<HTMLElement>("[data-feedback-done-extra]");
    const more = q<HTMLButtonElement>("[data-feedback-more]");

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let widget: TurnstileWidget | null = null;
    let widgetPromise: Promise<TurnstileWidget | null> | null = null;
    let pending = false;

    const ensureTurnstile = () => {
      widgetPromise ??= mountTurnstile(turnstileEl, "feedback")
        .then(w => (widget = w))
        .catch(() => null);
      return widgetPromise;
    };

    const setState = (state: "idle" | "open" | "done" | "sent") => {
      root.dataset.state = state;
      expand.inert = state !== "open";
    };

    const updateCount = () => {
      const length = comment.value.length;
      count.textContent = `${numberFormat.format(length)} / 2,000`;
      count.classList.toggle("text-ink", length > 1800);
      count.classList.toggle("text-ink-soft", length <= 1800);
    };

    const fieldError = (name: string) =>
      root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    const fieldInput = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;

    const clearErrors = () => {
      status.textContent = "";
      for (const name of FIELDS) {
        const error = fieldError(name);
        if (error) error.textContent = "";
        fieldInput(name)?.removeAttribute("aria-invalid");
      }
    };

    const choose = (helpful: Helpful) => {
      const wasOpen = root.dataset.state === "open";
      helpfulInput.value = helpful;
      question.textContent = QUESTIONS[helpful];
      for (const button of choices) {
        button.setAttribute("aria-pressed", String(button.dataset.helpful === helpful));
      }
      setState("open");
      void ensureTurnstile();
      if (!wasOpen) {
        // Wait for the reveal so focus doesn't scroll to a zero-height field.
        const delay = reduceMotion.matches ? 0 : 120;
        window.setTimeout(() => comment.focus({ preventScroll: true }), delay);
        window.setTimeout(
          () => expand.scrollIntoView({ block: "nearest", behavior: reduceMotion.matches ? "auto" : "smooth" }),
          reduceMotion.matches ? 0 : 280
        );
      }
    };

    const collapse = () => {
      const pressed = choices.find(b => b.getAttribute("aria-pressed") === "true");
      for (const button of choices) button.setAttribute("aria-pressed", "false");
      helpfulInput.value = "";
      clearErrors();
      setState("idle");
      pressed?.focus();
    };

    const showDone = (kind: "done" | "sent", email?: string) => {
      if (kind === "done") {
        doneText.textContent = "Thanks — your feedback reached me.";
        doneExtra.textContent = email ? ` I'll reply to ${email}.` : "";
        more.hidden = true;
      } else {
        doneText.textContent = "You already sent feedback on this post. Thanks!";
        doneExtra.textContent = "";
        more.hidden = false;
      }
      setState(kind);
    };

    const reopen = () => {
      for (const button of choices) button.setAttribute("aria-pressed", "false");
      helpfulInput.value = "";
      comment.value = "";
      updateCount();
      clearErrors();
      setState("idle");
      choices[0]?.focus();
    };

    const setPending = (value: boolean) => {
      pending = value;
      submit.disabled = value;
      submit.textContent = value ? "Sending…" : "Send feedback";
      form.setAttribute("aria-busy", String(value));
    };

    const onSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      if (pending) return;
      const helpful = helpfulInput.value as Helpful;
      if (helpful !== "yes" && helpful !== "no") {
        choices[0]?.focus();
        return;
      }

      clearErrors();

      // Client-side email check so readers don't wait on a round trip for a typo.
      const email = fieldInput("email") as HTMLInputElement;
      email.value = email.value.trim();
      if (email.value && !email.validity.valid) {
        const error = fieldError("email");
        if (error) error.textContent = "Enter a valid email address, or leave it empty.";
        email.setAttribute("aria-invalid", "true");
        email.focus();
        return;
      }

      setPending(true);
      await ensureTurnstile();
      // Wait for a token so a fast submit doesn't race the bot check.
      await widget?.ready();
      const formData = new FormData(form);

      try {
        const { error } = await actions.feedback(formData);
        if (!error) {
          writeSaved(slug, helpful);
          showDone("done", email.value || undefined);
          done.focus();
          return;
        }

        if (isInputError(error)) {
          let first: HTMLElement | null = null;
          for (const [name, messages] of Object.entries(error.fields ?? {})) {
            const input = fieldInput(name);
            const target = fieldError(name);
            if (!input || !target || !messages?.length) continue;
            target.textContent = messages[0] ?? "";
            input.setAttribute("aria-invalid", "true");
            first ??= input;
          }
          if (first) {
            first.focus();
          } else {
            status.textContent = "Something in the form needs fixing. Check it and send again.";
          }
        } else {
          status.textContent =
            error.message || "Your feedback couldn't be sent. Please try again.";
        }
      } catch {
        status.textContent = "Your feedback couldn't be sent. Check your connection and try again.";
      } finally {
        setPending(false);
        // Tokens are single-use: always get a fresh one for the next attempt.
        widget?.reset();
      }
    };

    const ac = new AbortController();
    const { signal } = ac;

    for (const button of choices) {
      button.addEventListener("click", () => choose(button.dataset.helpful as Helpful), {
        signal,
      });
    }
    comment.addEventListener("input", updateCount, { signal });
    cancel.addEventListener("click", collapse, { signal });
    more.addEventListener("click", reopen, { signal });
    form.addEventListener("submit", onSubmit, { signal });
    form.addEventListener(
      "input",
      event => {
        const target = event.target as HTMLElement;
        if (target.getAttribute("aria-invalid") !== "true") return;
        target.removeAttribute("aria-invalid");
        const name = target.getAttribute("name");
        const error = name ? fieldError(name) : null;
        if (error) error.textContent = "";
      },
      { signal }
    );
    root.addEventListener(
      "keydown",
      event => {
        if (event.key === "Escape" && root.dataset.state === "open" && !pending) collapse();
      },
      { signal }
    );

    cleanups.push(() => {
      ac.abort();
      widget?.remove();
    });

    updateCount();
    if (readSaved(slug)) showDone("sent");
    else setState("idle");
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    for (const cleanup of cleanups) cleanup();
    cleanups = [];
  });
</script>
