---
type Props = {
  /** Render without the page container (when placed inside a page header). */
  bare?: boolean;
};

const { bare = false } = Astro.props;

// Remove trailing slash, then split into segments
// eg: /tags/tailwindcss/2 => ['tags', 'tailwindcss', '2']
const segments = Astro.url.pathname
  .replace(/\/+$/, "")
  .split("/")
  .slice(1)
  .map(segment => decodeURIComponent(segment));

// Visible labels for top-level sections (URLs stay the same)
const labels: Record<string, string> = {
  posts: "Writing",
  archives: "Archive",
  tags: "Tags",
  search: "Search",
  about: "About",
};

type Crumb = { label: string; href?: string };
const crumbs: Crumb[] = [];

segments.forEach((segment, index) => {
  const href = `/${segments.slice(0, index + 1).join("/")}/`;
  const isPageNumber = index > 0 && /^\d+$/.test(segment);

  if (isPageNumber) {
    // Home / Writing / 1 => Home / Writing
    if (Number(segment) > 1) crumbs.push({ label: `Page ${segment}`, href });
    return;
  }

  crumbs.push({ label: index === 0 ? (labels[segment] ?? segment) : segment, href });
});

// The last crumb is the current page and is not a link
const last = crumbs.at(-1);
if (last) delete last.href;
---

<nav
  aria-label="breadcrumb"
  class:list={["type-meta text-ink-soft", { "app-layout mt-10 mb-2": !bare }]}
>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <li class="flex items-center gap-2">
      <a href="/" class="transition-colors hover:text-cobalt">Home</a>
      <span aria-hidden="true" class="text-line">/</span>
    </li>
    {
      crumbs.map((crumb, index) =>
        crumb.href ? (
          <li class="flex items-center gap-2">
            <a
              href={crumb.href}
              class:list={[
                "transition-colors hover:text-cobalt",
                { "normal-case": index > 0 },
              ]}
            >
              {crumb.label}
            </a>
            <span aria-hidden="true" class="text-line">/</span>
          </li>
        ) : (
          <li>
            <span
              aria-current="page"
              class:list={["text-ink", { "normal-case": index > 0 && !crumb.label.startsWith("Page") }]}
            >
              {crumb.label}
            </span>
          </li>
        )
      )
    }
  </ol>
</nav>
