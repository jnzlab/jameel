---
import IconDownload from "@/assets/icons/IconDownload.svg";
import IconMail from "@/assets/icons/IconMail.svg";
import Socials from "@/components/Socials.astro";
import { SITE } from "@/config";
---

<section id="hero" aria-labelledby="hero-name" class="hero pt-14 pb-20 sm:pt-24 sm:pb-28">
  <p class="hero-in type-meta flex flex-wrap items-center gap-x-2.5 gap-y-1 text-ink-soft">
    <span class="text-ink">
      Freelancing at
      <a href="https://www.innovorus.com/" target="_blank" rel="noopener noreferrer" class="link-ink">Innovorus</a>
    </span>
    <span aria-hidden="true" class="max-sm:hidden">·</span>
    <span class="flex gap-x-2.5 gap-y-1 max-sm:basis-full max-sm:flex-col">
      <span>Gujranwala, Pakistan</span>
      <span aria-hidden="true" class="max-sm:hidden">·</span>
      <span>Open to new projects</span>
    </span>
  </p>

  <h1 id="hero-name" class="hero-in hero-name type-display mt-8 text-ink sm:mt-10">
    <span class="block">Jameel</span>
    <span class="block">Ahmad<span class="hero-node" aria-hidden="true"></span></span>
  </h1>

  <div class="mt-10 grid gap-10 sm:mt-14 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="hero-in max-w-[40rem]" style="--d: 120ms">
      <p class="text-[1.2rem] leading-[1.55] text-ink sm:text-[1.4rem]">
        Full-stack developer. I build products with Next.js and TypeScript,
        from AI candidate screening to e-commerce on Cloudflare, ship them end
        to end, and write up the bugs I fix along the way.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="mailto:jameel@jnzlab.io" class="btn btn-primary">
          <IconMail class="size-4" aria-hidden="true" />
          Email me
        </a>
        <a
          href={SITE.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          <IconDownload class="size-4" aria-hidden="true" />
          Download resume
        </a>
      </div>
    </div>

    <div class="hero-in" style="--d: 200ms">
      <Socials rss class="lg:justify-end" />
    </div>
  </div>
</section>

<style>
  .hero {
    container-type: inline-size;
  }
  .hero-name {
    /* "Jameel" is ~4.1em wide: size it to nearly fill the hero column */
    font-size: clamp(3rem, 22.5cqi, 12.75rem);
    letter-spacing: -0.065em;
    line-height: 0.9;
    margin-inline-start: -0.04em;
  }
  .hero-name > span + span {
    /* indent the second line by one glyph: the name reads as a branch */
    padding-inline-start: 0.62em;
  }
  .hero-node {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    margin-inline-start: 0.1em;
    border-radius: 999px;
    background: var(--marigold);
    vertical-align: baseline;
  }

  .hero-in {
    animation: hero-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
