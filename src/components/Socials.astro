---
/**
 * Compact row of profile links (email excluded: the footer owns contact).
 * Optionally ends with the RSS feed.
 */
import IconRss from "@/assets/icons/IconRss.svg";
import { SOCIALS } from "@/constants";

type Props = { class?: string; rss?: boolean };

const { class: className, rss = false } = Astro.props;
const profiles = SOCIALS.filter(s => s.name !== "Mail");
const linkClass =
  "inline-flex items-center gap-1.5 py-1 text-sm font-medium text-ink-soft transition-colors hover:text-ink";
---

<ul class:list={["flex flex-wrap items-center gap-x-5 gap-y-1", className]}>
  {
    profiles.map(social => (
      <li>
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class={linkClass}
          title={social.linkTitle}
        >
          <social.icon class="size-4" aria-hidden="true" />
          {social.name}
        </a>
      </li>
    ))
  }
  {
    rss && (
      <li>
        <a href="/rss.xml" class={linkClass} title="Subscribe to the RSS feed">
          <IconRss class="size-4" aria-hidden="true" />
          RSS
        </a>
      </li>
    )
  }
</ul>
