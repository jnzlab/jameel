---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;

const base =
  "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold select-none transition-colors";
const enabled = "border-line text-ink hover:border-ink hover:text-cobalt";
const disabled = "cursor-not-allowed border-dashed border-line text-ink-soft/50";
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-14 grid grid-cols-[1fr_auto_1fr] items-center gap-4 border-t border-line pt-6"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={[base, "justify-self-start", page.url.prev ? enabled : disabled]}
        aria-label="Go to previous page (newer posts)"
      >
        <IconArrowLeft class="size-4 rtl:rotate-180" aria-hidden="true" />
        Newer
      </LinkButton>
      <p class="type-meta text-center text-ink-soft">
        Page <span class="text-ink">{page.currentPage}</span> of {page.lastPage}
      </p>
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={[base, "justify-self-end", page.url.next ? enabled : disabled]}
        aria-label="Go to next page (older posts)"
      >
        Older
        <IconArrowRight class="size-4 rtl:rotate-180" aria-hidden="true" />
      </LinkButton>
    </nav>
  )
}
