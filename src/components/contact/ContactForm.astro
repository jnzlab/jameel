---
/**
 * Contact form backed by the `contact` Astro Action. Needs JavaScript
 * (the action is called from the client script below); without it a
 * <noscript> note points to the email address instead.
 */
type Props = { email: string };

const { email } = Astro.props;

const inputClass =
  "field-input mt-2 block w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-ink transition-[border-color,box-shadow] duration-150 placeholder:text-ink-soft/70 hover:border-ink-soft focus:border-cobalt focus-visible:outline-offset-1";
const labelClass = "block text-[0.95rem] font-semibold text-ink";
const errorClass = "field-error mt-2 flex items-start gap-2 text-sm text-ink";
---

<div id="contact-form" class="contact-root scroll-mt-24" data-contact-root>
  <form
    class="rounded-2xl border border-line bg-surface p-5 sm:p-8"
    novalidate
    aria-labelledby="contact-form-title"
    data-contact-form
  >
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="contact-form-title" class="type-heading text-lg">Send a message</h2>
      <p class="type-meta text-ink-soft">All fields required</p>
    </div>

    <div class="mt-6 grid gap-5">
      <div>
        <label for="contact-name" class={labelClass}>Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength="100"
          aria-describedby="contact-name-error"
          class={inputClass}
        />
        <p id="contact-name-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="contact-email" class={labelClass}>Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          maxlength="254"
          aria-describedby="contact-email-hint contact-email-error"
          class={inputClass}
        />
        <p id="contact-email-hint" class="mt-1.5 text-sm text-ink-soft">
          I'll reply to this address.
        </p>
        <p id="contact-email-error" class={errorClass} hidden></p>
      </div>

      <div>
        <div class="flex items-baseline justify-between gap-4">
          <label for="contact-message" class={labelClass}>Message</label>
          <span
            id="contact-message-count"
            class="type-meta text-ink-soft tabular-nums"
            data-counter
          >
            <span data-count>0</span> / 5,000
          </span>
        </div>
        <textarea
          id="contact-message"
          name="message"
          rows="7"
          required
          minlength="10"
          maxlength="5000"
          aria-describedby="contact-message-hint contact-message-count contact-message-error"
          class:list={[inputClass, "min-h-40 resize-y leading-relaxed"]}></textarea>
        <p id="contact-message-hint" class="mt-1.5 text-sm text-ink-soft">
          A few sentences is plenty. Links are welcome.
        </p>
        <p id="contact-message-error" class={errorClass} hidden></p>
      </div>

      <!-- Honeypot: hidden from people and assistive tech; bots fill it in. -->
      <div class="sr-only" aria-hidden="true">
        <label for="contact-company">Company</label>
        <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <!-- Turnstile renders here (usually invisible) and adds its hidden token input. -->
    <div class="mt-4 empty:hidden" data-turnstile></div>

    <div
      class="form-status mt-5 rounded-lg border border-line bg-paper px-4 py-3 text-sm text-ink"
      role="alert"
      data-status
      hidden
    >
    </div>

    <div class="mt-6">
      <button type="submit" class="btn btn-primary disabled:cursor-wait disabled:opacity-70" data-submit>
        <span data-submit-label>Send message</span>
      </button>
    </div>

    <noscript>
      <p class="mt-5 rounded-lg border border-line bg-paper px-4 py-3 text-sm text-ink">
        This form needs JavaScript. Email me at
        <a href={`mailto:${email}`} class="link-ink">{email}</a> instead.
      </p>
    </noscript>
  </form>

  <div
    class="rounded-2xl border border-line bg-surface p-6 sm:p-8"
    data-success
    hidden
  >
    <div class="flex items-start gap-4">
      <span class="success-node mt-1.5 shrink-0" aria-hidden="true"></span>
      <div class="min-w-0">
        <h2 class="type-heading text-xl outline-none" tabindex="-1" data-success-title>
          Message sent.
        </h2>
        <p class="mt-3 text-ink-soft">
          I'll reply to <strong class="font-semibold break-all text-ink" data-success-email></strong>.
          If it doesn't turn up, check your spam folder or email me at
          <a href={`mailto:${email}`} class="link-ink">{email}</a>.
        </p>
        <button type="button" class="btn btn-ghost mt-6" data-reset>
          Send another message
        </button>
      </div>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-live></p>
</div>

<style>
  .field-input[aria-invalid="true"] {
    border-color: var(--ink);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--marigold) 55%, transparent);
  }
  .field-error::before,
  .form-status::before {
    content: "";
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.45em;
    border-radius: 999px;
    background: var(--marigold);
  }
  .form-status:not([hidden]) {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }
  .field-error[hidden] {
    display: none;
  }
  .success-node {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    background: var(--marigold);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--marigold) 25%, transparent);
  }
</style>

<script>
  import { actions, isInputError } from "astro:actions";
  import { mountTurnstile, type TurnstileWidget } from "@/scripts/turnstile";

  type Field = "name" | "email" | "message";
  const FIELDS: Field[] = ["name", "email", "message"];

  let widget: TurnstileWidget | null = null;

  function clientError(input: HTMLInputElement | HTMLTextAreaElement): string {
    const value = input.value.trim();
    switch (input.name) {
      case "name":
        return value ? "" : "Enter your name";
      case "email":
        return value && input.validity.valid ? "" : "Enter a valid email address";
      case "message":
        return value.length >= 10 ? "" : "Write at least 10 characters";
      default:
        return "";
    }
  }

  function initContactForm() {
    const root = document.querySelector<HTMLElement>("[data-contact-root]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const form = root.querySelector<HTMLFormElement>("[data-contact-form]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const live = root.querySelector<HTMLElement>("[data-live]")!;
    const submit = root.querySelector<HTMLButtonElement>("[data-submit]")!;
    const submitLabel = root.querySelector<HTMLElement>("[data-submit-label]")!;
    const success = root.querySelector<HTMLElement>("[data-success]")!;
    const successTitle = root.querySelector<HTMLElement>("[data-success-title]")!;
    const successEmail = root.querySelector<HTMLElement>("[data-success-email]")!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-reset]")!;
    const message = form.elements.namedItem("message") as HTMLTextAreaElement;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const turnstile = root.querySelector<HTMLElement>("[data-turnstile]")!;

    const field = (name: Field) =>
      form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;

    const updateCount = () => {
      count.textContent = message.value.length.toLocaleString("en-US");
    };

    const setFieldError = (name: Field, text: string) => {
      const input = field(name);
      const error = root.querySelector<HTMLElement>(`#contact-${name}-error`)!;
      error.textContent = text;
      error.hidden = !text;
      if (text) input.setAttribute("aria-invalid", "true");
      else input.removeAttribute("aria-invalid");
    };

    const clearErrors = () => {
      FIELDS.forEach(name => setFieldError(name, ""));
      status.hidden = true;
      status.textContent = "";
    };

    const showStatus = (text: string) => {
      status.textContent = text;
      status.hidden = false;
    };

    const setPending = (pending: boolean) => {
      submit.disabled = pending;
      submit.setAttribute("aria-disabled", String(pending));
      submitLabel.textContent = pending ? "Sending…" : "Send message";
      form.setAttribute("aria-busy", String(pending));
    };

    updateCount();
    message.addEventListener("input", updateCount);

    // Clear a field's error as soon as it's fixed.
    FIELDS.forEach(name => {
      const input = field(name);
      input.addEventListener("input", () => {
        if (input.getAttribute("aria-invalid") === "true" && !clientError(input)) {
          setFieldError(name, "");
        }
      });
    });

    mountTurnstile(turnstile, "contact")
      .then(w => {
        // The visitor may have navigated away while the script loaded.
        if (root.isConnected) widget = w;
        else w?.remove();
      })
      .catch(() => {
        widget = null;
      });

    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (submit.disabled) return;
      clearErrors();

      // Check locally first so an obvious typo doesn't cost a round trip.
      const invalid = FIELDS.map(name => [name, clientError(field(name))] as const).filter(
        ([, text]) => text
      );
      if (invalid.length) {
        invalid.forEach(([name, text]) => setFieldError(name, text));
        field(invalid[0][0]).focus();
        return;
      }

      setPending(true);
      const sentTo = field("email").value.trim();
      try {
        // Don't race the bot check: wait (briefly) for Turnstile's token first.
        await widget?.ready();
        const { error } = await actions.contact(new FormData(form));

        if (!error) {
          successEmail.textContent = sentTo;
          form.hidden = true;
          success.hidden = false;
          live.textContent = `Message sent. I'll reply to ${sentTo}.`;
          successTitle.focus();
          return;
        }

        if (isInputError(error)) {
          const fields = error.fields as Partial<Record<string, string[]>>;
          const withErrors = FIELDS.filter(name => fields[name]?.length);
          withErrors.forEach(name => setFieldError(name, fields[name]![0]));
          if (withErrors.length) {
            field(withErrors[0]).focus();
          } else {
            showStatus("Something in the form isn't right. Check it and try again.");
          }
        } else {
          // FORBIDDEN (bot check) and server errors carry a message that says what to do.
          showStatus(error.message || "Your message couldn't be sent. Please try again.");
          submit.focus();
        }
      } catch {
        showStatus("Couldn't reach the server. Check your connection and try again.");
        submit.focus();
      } finally {
        // Turnstile tokens are single-use: get a fresh one after every attempt.
        widget?.reset();
        setPending(false);
      }
    });

    resetBtn.addEventListener("click", () => {
      form.reset();
      clearErrors();
      updateCount();
      live.textContent = "";
      success.hidden = true;
      form.hidden = false;
      field("name").focus();
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
  document.addEventListener("astro:before-swap", () => {
    widget?.remove();
    widget = null;
  });
</script>
