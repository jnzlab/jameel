---
type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /** Optional post count shown after the name. */
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    class:list={[
      "chip gap-1 transition-colors hover:border-ink hover:text-ink",
      { "px-3 py-1 text-[0.8rem]": size === "lg" },
    ]}
  >
    <span transition:name={tag}
      ><span aria-hidden="true" class="text-ink-soft">#</span><span
        class="text-ink">{tagName}</span
      ></span
    >
    {
      count !== undefined && (
        <span class="ms-0.5 text-ink-soft tabular-nums">
          {count}
          <span class="sr-only">{count === 1 ? "post" : "posts"}</span>
        </span>
      )
    }
  </a>
</li>
