---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  /** Kept for backwards compatibility; "lg" bumps the size slightly. */
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  /**
   * "latest" (default) shows one date: the update date when the post was
   * modified, otherwise the publish date. "both" shows the publish date and,
   * when modified, the update date after it.
   */
  display?: "latest" | "both";
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  display = "latest",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const tz = postTimezone || SITE.timezone;
const isModified = !!modDatetime && modDatetime > pubDatetime;

const published = dayjs(pubDatetime).tz(tz);
const updated = isModified ? dayjs(modDatetime).tz(tz) : null;

const fmt = (d: dayjs.Dayjs) => d.format("D MMM YYYY"); // e.g. '22 Mar 2025'
---

<span
  class:list={[
    "type-meta inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-ink-soft",
    { "text-[0.8rem]": size === "lg" },
    className,
  ]}
>
  {
    display === "both" ? (
      <>
        <span>
          Published{" "}
          <time class="text-ink" datetime={published.toISOString()}>
            {fmt(published)}
          </time>
        </span>
        {updated && (
          <span>
            Updated{" "}
            <time class="text-ink" datetime={updated.toISOString()}>
              {fmt(updated)}
            </time>
          </span>
        )}
      </>
    ) : (
      <span>
        {updated && <>Updated </>}
        <time datetime={(updated ?? published).toISOString()}>
          {fmt(updated ?? published)}
        </time>
      </span>
    )
  }
</span>
