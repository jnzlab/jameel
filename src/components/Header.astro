---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import Logo from "./Logo.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentSegment = currentPath.split("/").filter(Boolean)[0];
  const pathSegment = path.split("/").filter(Boolean)[0];
  return currentSegment === pathSegment;
};

const navItems = [
  { href: "/posts", label: "Writing", match: "/posts" },
  ...(SITE.showArchives
    ? [{ href: "/archives", label: "Archive", match: "/archives" }]
    : []),
  { href: "/about", label: "About", match: "/about" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="btn btn-primary fixed start-4 -top-full z-[60] transition-all focus:top-4"
>
  Skip to content
</a>

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-paper/80 backdrop-blur-md transition-colors data-[scrolled=true]:border-line"
>
  <div class="app-layout flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE.title}, home`}>
      <Logo class="size-7 transition-transform duration-300 group-hover:rotate-[-8deg]" />
      <span class="type-heading text-[0.95rem] whitespace-nowrap">
        {SITE.title.toLowerCase()}
      </span>
    </a>

    <nav id="nav-menu" aria-label="Primary" class="flex items-center gap-1">
      <ul
        id="menu-items"
        class:list={[
          "hidden items-center gap-1 md:flex",
          // mobile sheet
          "max-md:data-[open=true]:flex max-md:fixed max-md:inset-x-0 max-md:top-16 max-md:flex-col max-md:items-stretch max-md:gap-0 max-md:border-b max-md:border-line max-md:bg-paper max-md:px-4 max-md:pb-4",
        ]}
      >
        {
          navItems.map(item => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "relative block rounded-full px-3 py-1.5 text-[0.95rem] font-medium text-ink-soft transition-colors hover:text-ink",
                  "max-md:rounded-none max-md:border-b max-md:border-line max-md:px-1 max-md:py-4 max-md:text-lg",
                  { "active-nav": isActive(item.match) },
                ]}
                aria-current={isActive(item.match) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={SITE.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block rounded-full px-3 py-1.5 text-[0.95rem] font-medium text-ink-soft transition-colors hover:text-ink max-md:rounded-none max-md:px-1 max-md:py-4 max-md:text-lg"
          >
            Resume<span aria-hidden="true" class="ms-0.5 text-xs">↗</span>
          </a>
        </li>
      </ul>

      <a
        href="/search"
        class="ms-1 flex size-9 items-center justify-center gap-2 rounded-full border border-line text-ink-soft transition-colors hover:border-ink hover:text-ink md:h-auto md:w-auto md:py-1.5 md:ps-3 md:pe-2"
        aria-label="Search posts"
        title="Search (⌘K)"
      >
        <IconSearch class="size-4" aria-hidden="true" />
        <kbd class="type-meta hidden rounded border border-line px-1.5 py-0.5 text-[0.65rem] normal-case md:inline">
          ⌘K
        </kbd>
      </a>

      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="relative size-9 rounded-full text-ink-soft transition-colors hover:text-ink"
            title="Toggle light and dark theme"
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }

      <button
        id="menu-btn"
        class="grid size-9 place-items-center rounded-full text-ink md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden size-5" />
        <IconMenuDeep id="menu-icon" class="size-5" />
      </button>
    </nav>
  </div>
</header>

<script>
  import { navigate } from "astro:transitions/client";

  function setupHeader() {
    const header = document.querySelector<HTMLElement>("#site-header");
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector<HTMLElement>("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    const onScroll = () => {
      header?.setAttribute("data-scrolled", String(window.scrollY > 8));
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", String(!isOpen));
      menuBtn.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
      menuItems.dataset.open = String(!isOpen);
      menuIcon.classList.toggle("hidden", !isOpen);
      closeIcon.classList.toggle("hidden", isOpen);
    });
  }

  // ⌘K / Ctrl+K or "/" opens search from anywhere
  document.addEventListener("keydown", event => {
    const target = event.target as HTMLElement | null;
    const typing =
      target?.isContentEditable ||
      ["INPUT", "TEXTAREA", "SELECT"].includes(target?.tagName ?? "");
    const isShortcut =
      ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") ||
      (event.key === "/" && !typing);
    if (!isShortcut) return;
    event.preventDefault();
    if (window.location.pathname.startsWith("/search")) {
      document.querySelector<HTMLInputElement>(".pagefind-ui__search-input")?.focus();
    } else {
      navigate("/search");
    }
  });

  setupHeader();
  document.addEventListener("astro:after-swap", setupHeader);
</script>
