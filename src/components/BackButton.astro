---
/**
 * Breadcrumb-style back link for post pages. Points at the page the reader
 * came from (sessionStorage "backUrl", set by list pages), falling back to
 * the writing index for readers arriving from search engines.
 */
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import { SITE } from "@/config";

type Props = { class?: string };

const { class: className = "" } = Astro.props;
---

{
  SITE.showBackButton && (
    <nav aria-label="Breadcrumb" class:list={["type-meta", className]} data-pagefind-ignore>
      <a
        id="back-button"
        href="/posts/"
        class="group -ms-1 inline-flex items-center gap-2 rounded-full py-1 ps-1 pe-2 text-ink-soft transition-colors hover:text-ink"
      >
        <IconArrowLeft
          class="size-3.5 transition-transform duration-200 group-hover:-translate-x-0.5 rtl:rotate-180"
          aria-hidden="true"
        />
        <span>
          <span class="sr-only">Back to </span>
          <span id="back-button-label">Writing</span>
        </span>
      </a>
    </nav>
  )
}

<script>
  /** Label the destination so the link reads like a breadcrumb. */
  function labelFor(url: string) {
    const path = url.split("?")[0].replace(/\/+$/, "") || "/";
    if (path === "/") return "Home";
    if (path.startsWith("/search")) return "Search results";
    if (path.startsWith("/archives")) return "Archive";
    if (path.startsWith("/tags/")) {
      const tag = path.split("/")[2];
      return tag ? `#${decodeURIComponent(tag)}` : "Tags";
    }
    if (path.startsWith("/tags")) return "Tags";
    if (path.startsWith("/about")) return "About";
    return "Writing";
  }

  function updateGoBackUrl() {
    const backButton = document.querySelector<HTMLAnchorElement>("#back-button");
    const label = document.querySelector<HTMLElement>("#back-button-label");
    const backUrl = sessionStorage.getItem("backUrl");

    if (backUrl && backButton) {
      backButton.href = backUrl;
      if (label) label.textContent = labelFor(backUrl);
    }
  }

  document.addEventListener("astro:page-load", updateGoBackUrl);
  updateGoBackUrl();
</script>
