---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
---

<div
  id="btt-btn-container"
  data-visible="false"
  data-pagefind-ignore
  class="group/btt pointer-events-none fixed end-4 bottom-5 z-40 translate-y-3 opacity-0 transition duration-300 data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 sm:end-6 sm:bottom-6"
>
  <button
    type="button"
    data-button="back-to-top"
    tabindex="-1"
    class="group relative grid size-11 place-items-center rounded-full border border-line bg-paper/90 text-ink backdrop-blur transition-colors hover:border-ink"
    title="Back to top"
  >
    <svg
      class="pointer-events-none absolute -inset-px size-[calc(100%+2px)] -rotate-90"
      viewBox="0 0 44 44"
      aria-hidden="true"
    >
      <circle
        id="progress-indicator"
        cx="22"
        cy="22"
        r="21"
        fill="none"
        stroke="var(--marigold)"
        stroke-width="2"
        pathLength="100"
        stroke-dasharray="100"
        stroke-dashoffset="100"
        stroke-linecap="round"></circle>
    </svg>
    <IconArrowNarrowUp
      class="size-[1.1rem] transition-transform duration-200 group-hover:-translate-y-0.5"
      aria-hidden="true"
    />
    <span class="sr-only">Back to top</span>
  </button>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const rootElement = document.documentElement;
    const btnContainer = document.querySelector("#btt-btn-container");
    const backToTopBtn = document.querySelector("[data-button='back-to-top']");
    const progressIndicator = document.querySelector("#progress-indicator");

    if (!btnContainer || !backToTopBtn || !progressIndicator) return;

    // Drop the listener left behind by the previous page (view transitions)
    window.__bttAbort?.abort();
    const controller = new AbortController();
    window.__bttAbort = controller;

    backToTopBtn.addEventListener("click", () => {
      document.body.scrollTop = 0; // Safari
      rootElement.scrollTop = 0;
      document.querySelector("#main-content")?.focus({ preventScroll: true });
    });

    let lastVisible = null;
    function handleScroll() {
      const scrollTotal = rootElement.scrollHeight - rootElement.clientHeight;
      const scrollTop = rootElement.scrollTop;
      const ratio = scrollTotal > 0 ? scrollTop / scrollTotal : 0;

      progressIndicator.setAttribute(
        "stroke-dashoffset",
        String(100 - Math.min(100, ratio * 100))
      );

      const isVisible = ratio > 0.3;
      if (isVisible !== lastVisible) {
        btnContainer.dataset.visible = String(isVisible);
        backToTopBtn.tabIndex = isVisible ? 0 : -1;
        lastVisible = isVisible;
      }
    }

    let ticking = false;
    document.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
      },
      { passive: true, signal: controller.signal }
    );
    handleScroll();
  })();
</script>
